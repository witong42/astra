{
  "name": "astra",
  "productName": "Astra",
  "version": "0.5.1",
  "astraBuild": 16,
  "description": "A personal desktop assistant that turns conversations into mini-apps.",
  "license": "MIT",
  "repository": "https://github.com/witong42/astra",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "postinstall": "bun node_modules/electron/install.js",
    "build": "bun scripts/build.ts",
    "build:web": "bun scripts/build-web.ts",
    "build:site": "bun scripts/build-marketing.ts",
    "start": "bun run build && electron .",
    "test": "bun test",
    "check": "biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "package": "bun run build && bun scripts/package.ts"
  },
  "dependencies": {
    "@json-render/core": "0.21.1",
    "@json-render/react": "0.21.1",
    "@openuidev/lang-core": "1.0.1",
    "@openuidev/react-lang": "1.0.1",
    "@phosphor-icons/react": "2.1.10",
    "@solar-icons/react": "2.3.3",
    "koffi": "3.3.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.0.0",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "electron"
  ]
}
