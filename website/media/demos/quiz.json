{
  "html": "<main id=\"substrate\"><style>html,body{margin:0;background:#141820;color:#edf0f5;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}*{box-sizing:border-box}button,input{font:inherit}button{cursor:pointer}#substrate{min-height:100vh}.demo{max-width:1140px;margin:auto;padding:42px}.brand{display:flex;align-items:center;justify-content:space-between;font-size:12px;color:#a6b2c4;letter-spacing:.13em}.tag{border:1px solid #3b4656;border-radius:30px;padding:8px 12px;font-size:10px;letter-spacing:.05em}h1{font-size:53px;line-height:1.1;letter-spacing:-.055em;font-weight:400;margin:44px 0 14px}h1 span{color:#dcc49a}.lead{font-size:16px;color:#b2bdcb;line-height:1.65;margin:0 0 32px}.two{display:grid;grid-template-columns:1.5fr 1fr;gap:24px}.panel{background:#1c2330;border:1px solid #354052;border-radius:14px;padding:25px}.kicker{font-size:10px;letter-spacing:.16em;color:#abb7c8;margin:0 0 16px}.panel h2{font-size:24px;letter-spacing:-.03em;font-weight:400;margin:0 0 22px}.row{padding:19px 0;border-top:1px solid #354052;display:flex;gap:15px;align-items:center}.row:first-child{border:0}.row strong{display:block;font-size:15px;font-weight:500}.row small{display:block;font-size:12px;color:#a8b6c7;margin-top:6px}.index{font-size:12px;color:#dcc49a;border:1px solid #4b4d4b;border-radius:50%;width:30px;height:30px;display:grid;place-items:center;flex:none}input[type=text]{background:#131a25;color:#edf0f5;border:1px solid #46536a;border-radius:7px;padding:12px;width:100%;outline:none}input:focus-visible,button:focus-visible{outline:2px solid #dcc49a;outline-offset:3px}input[type=checkbox]{accent-color:#dcc49a;width:18px;height:18px;flex:none}.primary{border:0;border-radius:8px;background:#d7c29d;color:#151b25;padding:12px 18px;min-height:43px}.quiet{background:transparent;color:#c7d2e3;border:1px solid #46536a;border-radius:8px;padding:11px 15px}.muted{color:#a9b7c9;font-size:13px;line-height:1.6}.meter{height:4px;background:#354052;border-radius:5px;margin:15px 0 24px}.meter i{display:block;height:100%;background:#dcc49a;border-radius:5px;transition:width .2s}.big{font-size:48px;letter-spacing:-.05em;margin:12px 0}.field{font-size:12px;color:#a9b7c9;display:block;margin-bottom:9px}.add{display:flex;gap:12px;margin-top:20px}.add input{min-width:0}.footer{margin-top:26px;color:#8e9caf;font-size:11px}.done strong{text-decoration:line-through;color:#8b9bab}.choices{display:grid;grid-template-columns:1fr 1fr;gap:13px;margin:28px 0}.choice{background:#222d3c;border:1px solid #46536a;color:#edf0f5;border-radius:10px;padding:19px;text-align:left;font-size:22px}.choice.correct{border-color:#a1c6ad;background:#233b31}.choice.wrong{border-color:#c78686;background:#3c2930}.question{font-size:35px!important;line-height:1.35;max-width:670px}.feedback{min-height:22px;color:#dcc49a;font-size:14px}.label-row{display:flex;justify-content:space-between;gap:14px;align-items:center}.pill{border:1px solid #46536a;border-radius:20px;padding:7px 11px;font-size:11px;color:#c4cfdd}@media(max-width:650px){.demo{padding:24px}.two{grid-template-columns:1fr}h1{font-size:39px;margin-top:32px}.choices{grid-template-columns:1fr}.question{font-size:29px!important}}</style><div class=\"demo\"><header class=\"brand\"><span>✦ QUIZ DEMO</span><span class=\"tag\">DEMO · SAMPLE DATA</span></header><h1>A little curiosity<span>.</span></h1><p class=\"lead\">Three questions. A little pause to learn.</p><div class=\"two\"><section class=\"panel\"><div class=\"label-row\"><p class=\"kicker\">A QUICK QUIZ</p><span class=\"pill\" id=\"question-count\">1 / 3</span></div><h2 class=\"question\" id=\"question\">What is 7 × 8?</h2><div class=\"choices\" id=\"choices\"><button class=\"choice\" data-answer=\"0\">54</button><button class=\"choice\" data-answer=\"1\">56</button><button class=\"choice\" data-answer=\"2\">64</button><button class=\"choice\" data-answer=\"3\">48</button></div><p id=\"quiz-feedback\" class=\"feedback\" role=\"status\"></p><button id=\"quiz-next\" class=\"primary\" hidden=\"\">Next question →</button><button id=\"quiz-reset\" class=\"quiet\" hidden=\"\">Start again</button></section><aside class=\"panel\"><p class=\"kicker\">YOUR PROGRESS</p><p class=\"big\" id=\"quiz-score\">0 points</p><div class=\"meter\"><i id=\"quiz-progress\" style=\"width: 0%;\"></i></div><h2>At your own pace</h2><p class=\"muted\">Choose an answer. Check the explanation before you continue.</p></aside></div><p class=\"footer\">Example tool made with Astra · Sample questions.</p></div><script id=\"demo-state\" type=\"application/json\">{\"index\":0,\"answers\":[]}</script><script>(()=>{const r=document.getElementById('substrate');r._demoCleanup?.();const e=new AbortController(),signal=e.signal,data=r.querySelector('#demo-state'),s=JSON.parse(data.textContent),questions=[{q:'What is 7 × 8?',a:['54','56','64','48'],correct:1,why:'7 × 8 = 56.'},{q:'Quelle est la capitale de la France ?',a:['Lyon','Paris','Lille','Bordeaux'],correct:1,why:'Paris est la capitale de la France.'},{q:'Quel mot est un verbe ?',a:['Courir','Maison','Bleu','Demain'],correct:0,why:'Courir décrit une action : c’est un verbe.'}],save=()=>data.textContent=JSON.stringify(s);function render(){const done=s.index>=questions.length,score=s.answers.filter((a,i)=>a===questions[i].correct).length;r.querySelector('#quiz-score').textContent=score+(score>1?' points':' point');r.querySelector('#quiz-progress').style.width=(s.answers.length/3*100)+'%';r.querySelector('#quiz-reset').hidden=!done;r.querySelector('#quiz-next').hidden=done||s.answers[s.index]===undefined;r.querySelector('#question-count').textContent=done?'Terminé':(s.index+1)+' / 3';r.querySelector('#question').textContent=done?'Une petite pause, quelques idées en plus.':questions[s.index].q;const list=r.querySelector('#choices');list.replaceChildren();if(done){r.querySelector('#quiz-feedback').textContent=score+' bonne'+(score>1?'s':'')+' réponse'+(score>1?'s':'')+' sur 3.';return}const q=questions[s.index],answer=s.answers[s.index];q.a.forEach((v,i)=>{const b=document.createElement('button');b.className='choice'+(answer!==undefined?(i===q.correct?' correct':i===answer?' wrong':''):'');b.textContent=v;b.disabled=answer!==undefined;b.dataset.answer=i;list.append(b)});r.querySelector('#quiz-feedback').textContent=answer===undefined?'':(answer===q.correct?'That is right. ':'À retenir : ')+q.why;}r.addEventListener('click',event=>{const b=event.target.closest('[data-answer]');if(b&&s.answers[s.index]===undefined){s.answers[s.index]=Number(b.dataset.answer);save();render()}},{signal});r.querySelector('#quiz-next').addEventListener('click',()=>{s.index++;save();render()},{signal});r.querySelector('#quiz-reset').addEventListener('click',()=>{s.index=0;s.answers=[];save();render()},{signal});render();r._demoCleanup=()=>e.abort()})();</script></main>",
  "css": ""
}
