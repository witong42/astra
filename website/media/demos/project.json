{
  "html": "<main id=\"substrate\"><style>html,body{margin:0;background:#141820;color:#edf0f5;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}*{box-sizing:border-box}button,input{font:inherit}button{cursor:pointer}#substrate{min-height:100vh}.demo{max-width:1140px;margin:auto;padding:42px}.brand{display:flex;align-items:center;justify-content:space-between;font-size:12px;color:#a6b2c4;letter-spacing:.13em}.tag{border:1px solid #3b4656;border-radius:30px;padding:8px 12px;font-size:10px;letter-spacing:.05em}h1{font-size:53px;line-height:1.1;letter-spacing:-.055em;font-weight:400;margin:44px 0 14px}h1 span{color:#dcc49a}.lead{font-size:16px;color:#b2bdcb;line-height:1.65;margin:0 0 32px}.two{display:grid;grid-template-columns:1.5fr 1fr;gap:24px}.panel{background:#1c2330;border:1px solid #354052;border-radius:14px;padding:25px}.kicker{font-size:10px;letter-spacing:.16em;color:#abb7c8;margin:0 0 16px}.panel h2{font-size:24px;letter-spacing:-.03em;font-weight:400;margin:0 0 22px}.row{padding:19px 0;border-top:1px solid #354052;display:flex;gap:15px;align-items:center}.row:first-child{border:0}.row strong{display:block;font-size:15px;font-weight:500}.row small{display:block;font-size:12px;color:#a8b6c7;margin-top:6px}.index{font-size:12px;color:#dcc49a;border:1px solid #4b4d4b;border-radius:50%;width:30px;height:30px;display:grid;place-items:center;flex:none}input[type=text]{background:#131a25;color:#edf0f5;border:1px solid #46536a;border-radius:7px;padding:12px;width:100%;outline:none}input:focus-visible,button:focus-visible{outline:2px solid #dcc49a;outline-offset:3px}input[type=checkbox]{accent-color:#dcc49a;width:18px;height:18px;flex:none}.primary{border:0;border-radius:8px;background:#d7c29d;color:#151b25;padding:12px 18px;min-height:43px}.quiet{background:transparent;color:#c7d2e3;border:1px solid #46536a;border-radius:8px;padding:11px 15px}.muted{color:#a9b7c9;font-size:13px;line-height:1.6}.meter{height:4px;background:#354052;border-radius:5px;margin:15px 0 24px}.meter i{display:block;height:100%;background:#dcc49a;border-radius:5px;transition:width .2s}.big{font-size:48px;letter-spacing:-.05em;margin:12px 0}.field{font-size:12px;color:#a9b7c9;display:block;margin-bottom:9px}.add{display:flex;gap:12px;margin-top:20px}.add input{min-width:0}.footer{margin-top:26px;color:#8e9caf;font-size:11px}.done strong{text-decoration:line-through;color:#8b9bab}.choices{display:grid;grid-template-columns:1fr 1fr;gap:13px;margin:28px 0}.choice{background:#222d3c;border:1px solid #46536a;color:#edf0f5;border-radius:10px;padding:19px;text-align:left;font-size:22px}.choice.correct{border-color:#a1c6ad;background:#233b31}.choice.wrong{border-color:#c78686;background:#3c2930}.question{font-size:35px!important;line-height:1.35;max-width:670px}.feedback{min-height:22px;color:#dcc49a;font-size:14px}.label-row{display:flex;justify-content:space-between;gap:14px;align-items:center}.pill{border:1px solid #46536a;border-radius:20px;padding:7px 11px;font-size:11px;color:#c4cfdd}@media(max-width:650px){.demo{padding:24px}.two{grid-template-columns:1fr}h1{font-size:39px;margin-top:32px}.choices{grid-template-columns:1fr}.question{font-size:29px!important}}.focus-view .two{grid-template-columns:1fr}.focus-view .two>section{display:none}.focus-view .big{font-size:74px}.focus-view #next-task{font-size:30px;color:#edf0f5}.project-view{margin-bottom:22px;color:#a9b7c9;font-size:12px}</style><div class=\"demo\"><header class=\"brand\"><span>✦ PROJECT DEMO</span><span class=\"tag\">DEMO · SAMPLE DATA</span></header><h1>A project in <span>motion.</span></h1><p class=\"lead\">Keep your tasks and the next step in sight.</p><div class=\"label-row project-view\"><span>A view that fits your pace</span><button id=\"project-view\" class=\"quiet\" type=\"button\">Focus view</button></div><div class=\"two\"><section class=\"panel\"><p class=\"kicker\">A WEBSITE LAUNCH</p><h2>The next steps</h2><div id=\"task-list\"></div><form id=\"task-form\" class=\"add\"><input id=\"task-name\" type=\"text\" aria-label=\"Nouvelle tâche\" placeholder=\"Add a step…\" maxlength=\"100\"><button class=\"primary\" type=\"submit\">Add</button></form><p id=\"task-error\" class=\"feedback\" role=\"status\"></p></section><aside class=\"panel\"><p class=\"kicker\">YOUR PROGRESS</p><p class=\"big\" id=\"progress-value\">1 / 3</p><div class=\"meter\"><i id=\"progress-bar\" style=\"width:33%\"></i></div><h2>The next step</h2><p id=\"next-task\" class=\"muted\">Review the design</p><p class=\"muted\">Check off a completed step to see what is next.</p></aside></div><p class=\"footer\">Example tool made with Astra · Sample project and tasks.</p></div><script id=\"demo-state\" type=\"application/json\">{\"tasks\":[{\"text\":\"Prepare the content\",\"done\":true},{\"text\":\"Review the design\",\"done\":false},{\"text\":\"Publish the approved version\",\"done\":false}]}</script><script>(()=>{const r=document.getElementById('substrate');r._demoCleanup?.();const e=new AbortController(),signal=e.signal,data=r.querySelector('#demo-state'),s=JSON.parse(data.textContent),save=()=>data.textContent=JSON.stringify(s);function render(){r.classList.toggle('focus-view',!!s.focus);r.querySelector('#project-view').textContent=s.focus?'Full view':'Focus view';const list=r.querySelector('#task-list');list.replaceChildren();s.tasks.forEach((t,i)=>{const row=document.createElement('label');row.className='row'+(t.done?' done':'');const input=document.createElement('input');input.type='checkbox';input.checked=t.done;input.dataset.task=i;const strong=document.createElement('strong');strong.textContent=t.text;row.append(input,strong);list.append(row)});const n=s.tasks.filter(t=>t.done).length;r.querySelector('#progress-value').textContent=n+' / '+s.tasks.length;r.querySelector('#progress-bar').style.width=(s.tasks.length?n/s.tasks.length*100:0)+'%';r.querySelector('#next-task').textContent=s.tasks.find(t=>!t.done)?.text||'All steps are complete.';}r.addEventListener('change',event=>{if(event.target.matches('[data-task]')){s.tasks[Number(event.target.dataset.task)].done=event.target.checked;save();render()}},{signal});r.querySelector('#task-form').addEventListener('submit',event=>{event.preventDefault();const input=r.querySelector('#task-name'),value=input.value.trim();if(!value){r.querySelector('#task-error').textContent='Écrivez une étape à ajouter.';return}s.tasks.push({text:value,done:false});input.value='';r.querySelector('#task-error').textContent='Étape ajoutée.';save();render()},{signal});r.querySelector('#project-view').addEventListener('click',()=>{s.focus=!s.focus;save();render()},{signal});render();r._demoCleanup=()=>e.abort()})();</script></main>",
  "css": ""
}
